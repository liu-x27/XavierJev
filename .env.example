# The judge reads token probabilities, so it talks to an OpenAI-compatible
# endpoint that returns logprobs. A local Ollama works and needs no real key:
#   AGENT_JUDGE_API_KEY=ollama
#   AGENT_JUDGE_BASE_URL=http://localhost:11434/v1
#   AGENT_JUDGE_MODEL=llama3.1:8b
AGENT_JUDGE_API_KEY=
AGENT_JUDGE_BASE_URL=
AGENT_JUDGE_MODEL=

# The endpoint must return logprobs, and the model must answer in its first
# token. Reasoning models emit <think> first and will not work; LlmJudge.probe()
# asks a control question and reports what the endpoint actually did.

# The judge's own warnings: debug | info | warn | error | silent (default info)
AGENT_LOG_LEVEL=info

# Only for eval/*/generate-pool.mjs, which asks a model for new, unlabelled
# commands or requests to label. Nothing else calls Anthropic.
ANTHROPIC_API_KEY=
